NODE_ENV=development
PORT=5000

# PostgreSQL — Neon production string, or local Docker:
# DATABASE_URL=postgresql://leadflow:leadflow@localhost:5432/leadflow
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_NAME=lead_mgmt_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS — comma-separated frontend origins (no trailing slash)
# Local:
CLIENT_URL=http://localhost:5173
# Production example (Render):
# CLIENT_URL=https://leadflow-frontend-delta.vercel.app
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

BCRYPT_ROUNDS=12
